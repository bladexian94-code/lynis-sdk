#!/bin/sh
#
# Lynis Development Kit  --  version mejorada 1.1.0
# Repositorio original: https://github.com/CISOfy/lynis-sdk
#
# Cambios respecto a v1.0.6:
#   - Colores portables via tput con fallback seguro
#   - Logging funcional con timestamps escritos en LOGFILE
#   - Parseo de config robusto (comentarios, espacios, valores con '=')
#   - Flags CLI: --help, --version, --verbose, --dry-run, --config
#   - _parse_args integrado (ya no se sourcea include/parameters)
#   - trap para cleanup garantizado de archivos temporales
#   - Validacion de version minima de Lynis (POSIX sort)
#   - Codigos de salida CI-friendly en todos los modos
#   - grep -E en lugar de egrep (deprecated en POSIX moderno)
#   - Eliminados backticks; todo usa $()

set -o nounset

# -- Constantes ---------------------------------------------------------------
DEVKIT_RELEASE="20260414"
DEVKIT_VERSION="1.1.0"
DEVKIT_MIN_LYNIS_VERSION="3.0.0"

CONFIG_FILE="config"
MODE="do-nothing"
MY_USER_ID=$(id -u)
VERBOSE=0
DRY_RUN=0
LOGFILE="./lynis-dev.log"
ERRORS=0
WARNINGS=0
LYNIS_PATH=""
LYNIS_VERSION=""

# -- Colores portables con tput -----------------------------------------------
_setup_colors() {
    if [ -t 1 ] && command -v tput > /dev/null 2>&1; then
        NORMAL=$(tput sgr0)
        BOLD=$(tput bold)
        RED=$(tput setaf 1)
        GREEN=$(tput setaf 2)
        YELLOW=$(tput setaf 3)
        CYAN=$(tput setaf 6)
    else
        NORMAL="" ; BOLD="" ; RED="" ; GREEN="" ; YELLOW="" ; CYAN=""
    fi
    SECTION="${CYAN}${BOLD}"
}
_setup_colors

# -- Logging y output ---------------------------------------------------------
_log() {
    local level="$1"
    shift
    printf "[%s] [%s] %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "${level}" "$*" >> "${LOGFILE}"
}
_info()  { printf "${CYAN}[INFO]${NORMAL}  %s\n" "$*" ;  _log "INFO"  "$*" ; }
_ok()    { printf "${GREEN}[ OK ]${NORMAL}  %s\n" "$*" ; _log "OK"    "$*" ; }
_warn()  { WARNINGS=$((WARNINGS+1)) ; printf "${YELLOW}[WARN]${NORMAL}  %s\n" "$*" >&2 ; _log "WARN" "$*" ; }
_error() { ERRORS=$((ERRORS+1))    ; printf "${RED}[ERR] ${NORMAL}  %s\n" "$*" >&2 ; _log "ERROR" "$*" ; }
_fatal() { printf "${RED}[FATAL]${NORMAL} %s\n" "$*" >&2 ; _log "FATAL" "$*" ; exit 1 ; }
_sep()   { printf "========================================================================\n" ; }

# -- Ayuda --------------------------------------------------------------------
_show_help() {
    cat << HELPEOF
${BOLD}Lynis Development Kit${NORMAL} ${DEVKIT_VERSION}

${BOLD}USO${NORMAL}
  $0 [OPCIONES] COMANDO [SUBCOMANDO]

${BOLD}COMANDOS DE CONSTRUCCION${NORMAL}
  build all             Construir paquetes DEB y RPM
  build deb             Construir paquete DEB (Debian/Ubuntu)
  build rpm             Construir paquete RPM (RHEL/CentOS/Fedora)

${BOLD}COMANDOS DE CALIDAD${NORMAL}
  run checks            Comprobaciones de estilo y convenciones
  run linters           Analisis estatico con shellcheck
  run spelling-check    Verificacion ortografica (requiere aspell)
  run unit-tests        Ejecutar tests unitarios

${BOLD}COMANDOS DE IDIOMA${NORMAL}
  update language-files Actualizar archivos de traduccion

${BOLD}OPCIONES${NORMAL}
  --help,    -h         Mostrar esta ayuda y salir
  --version             Mostrar version del devkit y salir
  --verbose, -v         Salida detallada
  --dry-run             Simular sin ejecutar acciones reales
  --config   ARCHIVO    Usar archivo de configuracion alternativo

${BOLD}EJEMPLOS${NORMAL}
  $0 run unit-tests
  $0 --verbose run linters
  $0 --dry-run build deb
  $0 --config /etc/lynis-sdk/config run checks

HELPEOF
}

_show_version() {
    printf "lynis-devkit %s (release %s)\n" "${DEVKIT_VERSION}" "${DEVKIT_RELEASE}"
}

# -- Parseo de config robusto -------------------------------------------------
# Maneja: comentarios (#), espacios alrededor de '=', lineas vacias
_config_get() {
    local key="$1"
    local default="${2:-}"
    local val
    val=$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "${CONFIG_FILE}" \
          | grep -v "^[[:space:]]*#" \
          | head -1 \
          | sed 's/^[^=]*=[[:space:]]*//' \
          | sed 's/[[:space:]]*$//')
    if [ -z "${val}" ]; then
        printf "%s" "${default}"
    else
        printf "%s" "${val}"
    fi
}

# -- Comparacion semantica de versiones (POSIX, sin bashismos) ----------------
# Retorna 0 si ver1 >= ver2
_version_gte() {
    local ver1="$1"
    local ver2="$2"
    printf "%s\n%s\n" "${ver1}" "${ver2}" \
        | sort -t. -k1,1n -k2,2n -k3,3n \
        | head -1 \
        | grep -qF "${ver2}"
}

# -- Cleanup de archivos temporales -------------------------------------------
_TMPFILES=""
_cleanup() {
    local code=$?
    for f in ${_TMPFILES}; do
        if [ -f "${f}" ]; then rm -f "${f}" ; fi
    done
    if [ "${code}" -ne 0 ] && [ "${MODE}" != "do-nothing" ]; then
        _log "EXIT" "Codigo de salida: ${code}"
    fi
}
trap _cleanup EXIT INT TERM

_mktmp() {
    local tmp
    tmp=$(mktemp /tmp/lynis-devkit-XXXXXXXXXX)
    _TMPFILES="${_TMPFILES} ${tmp}"
    printf "%s" "${tmp}"
}

# -- Parseado de argumentos CLI -----------------------------------------------
_parse_args() {
    if [ $# -eq 0 ]; then
        MODE="do-nothing"
        return 0
    fi
    while [ $# -ge 1 ]; do
        case "$1" in
            --help|-h)
                _show_help ; exit 0 ;;
            --version)
                _show_version ; exit 0 ;;
            --verbose|-v)
                VERBOSE=1 ; shift ;;
            --dry-run)
                DRY_RUN=1 ; shift ;;
            --config)
                if [ $# -ge 2 ]; then
                    CONFIG_FILE="$2" ; shift 2
                else
                    echo "Error: --config requiere un argumento" >&2 ; exit 1
                fi
                ;;
            build)
                if [ $# -ge 2 ]; then
                    case "$2" in
                        all)      MODE="build-all" ;;
                        deb|dpkg) MODE="build-deb" ;;
                        rpm)      MODE="build-rpm" ;;
                        *)
                            echo "Error: objetivo de build desconocido: '$2'" >&2
                            echo "Validos: all, deb, rpm" >&2 ; exit 1 ;;
                    esac
                    shift 2
                else
                    echo "Error: 'build' requiere un objetivo" >&2
                    echo "Ejemplos: $0 build deb | $0 build rpm | $0 build all" >&2
                    exit 1
                fi
                ;;
            run)
                if [ $# -ge 2 ]; then
                    case "$2" in
                        checks)         MODE="run-checks"         ;;
                        linters)        MODE="run-linters"        ;;
                        spelling-check) MODE="run-spelling-check" ;;
                        unit-tests)     MODE="run-unit-tests"     ;;
                        *)
                            echo "Error: subcomando 'run' desconocido: '$2'" >&2 ; exit 1 ;;
                    esac
                    shift 2
                else
                    echo "Error: 'run' requiere un subcomando" >&2
                    echo "Ejemplos: $0 run checks | $0 run linters | $0 run unit-tests" >&2
                    exit 1
                fi
                ;;
            update)
                if [ $# -ge 2 ]; then
                    case "$2" in
                        language-files) MODE="update-language-files" ;;
                        *)
                            echo "Error: subcomando 'update' desconocido: '$2'" >&2 ; exit 1 ;;
                    esac
                    shift 2
                else
                    echo "Error: 'update' requiere un subcomando" >&2
                    echo "Ejemplo: $0 update language-files" >&2
                    exit 1
                fi
                ;;
            *)
                echo "Error: argumento desconocido: '$1'" >&2
                echo "Use --help para ver la ayuda." >&2
                exit 1 ;;
        esac
    done
}

# -- Comprobaciones previas al inicio -----------------------------------------
_preflight_checks() {
    if [ "${MY_USER_ID}" = "0" ]; then
        _fatal "No ejecutar como root. Use un usuario sin privilegios."
    fi
    if [ ! -f "${CONFIG_FILE}" ]; then
        _fatal "Archivo de configuracion no encontrado: '${CONFIG_FILE}'"
    fi

    LYNIS_PATH=$(_config_get "lynis-directory")
    if [ -z "${LYNIS_PATH}" ] || [ ! -d "${LYNIS_PATH}" ]; then
        _fatal "Directorio Lynis no encontrado. Verifique 'lynis-directory' en ${CONFIG_FILE}"
    fi
    if [ ! -f "${LYNIS_PATH}/lynis" ]; then
        _fatal "Script Lynis no encontrado en: ${LYNIS_PATH}/lynis"
    fi

    LYNIS_VERSION=$(grep -m1 "^PROGRAM_VERSION=" "${LYNIS_PATH}/lynis" \
                    | sed 's/PROGRAM_VERSION=//;s/"//g;s/[[:space:]]//g')
    if [ -z "${LYNIS_VERSION}" ]; then
        _warn "No se pudo detectar la version de Lynis"
        LYNIS_VERSION="unknown"
    else
        if ! _version_gte "${LYNIS_VERSION}" "${DEVKIT_MIN_LYNIS_VERSION}" 2>/dev/null; then
            _warn "Lynis ${LYNIS_VERSION} es anterior a la version minima recomendada (${DEVKIT_MIN_LYNIS_VERSION})"
        fi
    fi

    if [ "${VERBOSE}" -eq 0 ]; then
        local cfg_v
        cfg_v=$(_config_get "verbose" "no")
        case "${cfg_v}" in
            yes|YES|true|TRUE|1) VERBOSE=1 ;;
        esac
    fi
}

# -- Cargar includes ----------------------------------------------------------
_load_includes() {
    local f="${LYNIS_PATH}/include/functions"
    if [ -f "${f}" ]; then
        if [ "${VERBOSE}" -eq 1 ]; then _info "Cargando funciones Lynis: ${f}" ; fi
        # shellcheck source=/dev/null
        . "${f}"
    else
        _warn "Funciones de Lynis no encontradas: ${f}"
    fi

    f="./include/devkit-functions"
    if [ -f "${f}" ]; then
        if [ "${VERBOSE}" -eq 1 ]; then _info "Cargando funciones devkit" ; fi
        # shellcheck source=/dev/null
        . "${f}"
    else
        _fatal "Funciones del devkit no encontradas: ${f}"
    fi
}

# -- Suite runner generico ----------------------------------------------------
# Sourcea cada archivo del directorio, llama Assert() y acumula resultados
_run_suite() {
    local suite_dir="$1"
    local pattern="$2"
    local label="$3"
    local failed=0
    local passed=0
    local total=0

    if [ ! -d "${suite_dir}" ]; then
        _warn "Directorio '${suite_dir}' no encontrado, omitiendo"
        return 0
    fi

    while IFS= read -r FILE; do
        if [ -z "${FILE}" ]; then continue ; fi
        total=$((total+1))
        if [ "${VERBOSE}" -eq 1 ]; then _info "${label}: ${FILE}" ; fi
        if [ "${DRY_RUN}" -eq 1 ]; then
            _info "[dry-run] Ejecutaria: ${FILE}" ; continue
        fi
        printf "------------------------------------------------------------------------\n"
        # shellcheck source=/dev/null
        . "${FILE}"
        if Assert; then
            passed=$((passed+1))
        else
            failed=$((failed+1))
            _error "Fallo en: ${FILE}"
        fi
    done << FILELIST
$(find "${suite_dir}" -name "${pattern}" -type f | sort)
FILELIST

    if [ "${DRY_RUN}" -eq 0 ]; then
        _info "${label}: ${passed}/${total} OK, ${failed} fallidos"
    fi
    return "${failed}"
}

# -- Ejecutores de modos ------------------------------------------------------
_run_checks()     { _run_suite "./checks"     "check-*"  "Check"     ; }
_run_unit_tests() { _run_suite "./unit-tests" "tests-*"  "Unit-test" ; }

_run_linters() {
    _info "Ejecutando linters..."
    if [ ! -d "./linters" ]; then
        _warn "Directorio './linters' no encontrado" ; return 0
    fi
    while IFS= read -r FILE; do
        if [ -z "${FILE}" ]; then continue ; fi
        if [ "${VERBOSE}" -eq 1 ]; then _info "Linter: ${FILE}" ; fi
        if [ "${DRY_RUN}" -eq 1 ]; then
            _info "[dry-run] Linter: ${FILE}" ; continue
        fi
        printf "\n${SECTION}=== Linter: %s ===${NORMAL}\n" "${FILE}"
        # shellcheck source=/dev/null
        . "${FILE}"
    done << FILELIST
$(find ./linters -type f -name "linter-*" | sort)
FILELIST
}

_run_spelling_check() {
    _info "Ejecutando comprobacion ortografica..."
    if [ "${DRY_RUN}" -eq 1 ]; then
        _info "[dry-run] grammar-check-spelling" ; return 0
    fi
    if [ -f "./grammar/grammar-check-spelling" ]; then
        # shellcheck source=/dev/null
        . ./grammar/grammar-check-spelling
    else
        _warn "Archivo ./grammar/grammar-check-spelling no encontrado"
    fi
}

_update_language_files() {
    _info "Actualizando archivos de idioma..."
    if [ ! -d "./languages" ]; then
        _warn "Directorio './languages' no encontrado" ; return 0
    fi
    while IFS= read -r FILE; do
        if [ -z "${FILE}" ]; then continue ; fi
        if [ "${DRY_RUN}" -eq 1 ]; then
            _info "[dry-run] Actualizaria: ${FILE}" ; continue
        fi
        # shellcheck source=/dev/null
        . "${FILE}"
        UpdateLanguageFiles
    done << FILELIST
$(find ./languages -name "languages-*" -type f | sort)
FILELIST
}

# -- Programa principal -------------------------------------------------------
main() {
    _parse_args "$@"
    _preflight_checks
    _load_includes

    _sep
    printf "  ${BOLD}Lynis Development Kit${NORMAL}  v%s [%s]\n" "${DEVKIT_VERSION}" "${DEVKIT_RELEASE}"
    printf "  Directorio Lynis : %s\n" "${LYNIS_PATH}"
    printf "  Version Lynis    : %s\n" "${LYNIS_VERSION}"
    printf "  Verbose          : %s\n" "${VERBOSE}"
    printf "  Dry-run          : %s\n" "${DRY_RUN}"
    printf "  Log              : %s\n" "${LOGFILE}"
    _sep
    printf "\n"

    EXIT_CODE=0
    case "${MODE}" in
        build-all)              SDKBuildPackageDEB ; SDKBuildPackageRPM ;;
        build-deb|build-dpkg)  SDKBuildPackageDEB ;;
        build-rpm)             SDKBuildPackageRPM ;;
        run-checks)            _run_checks         || EXIT_CODE=$? ;;
        run-linters)           _run_linters        || EXIT_CODE=$? ;;
        run-spelling-check)    _run_spelling_check || EXIT_CODE=$? ;;
        run-unit-tests)        _run_unit_tests     || EXIT_CODE=$? ;;
        update-language-files) _update_language_files || EXIT_CODE=$? ;;
        do-nothing)            _show_help ;;
    esac

    printf "\n"
    if [ "${EXIT_CODE}" -eq 0 ]; then
        _ok "Finalizado correctamente  |  Warnings: ${WARNINGS}"
    else
        _error "Finalizado con errores (codigo: ${EXIT_CODE})  |  Errors: ${ERRORS}  Warnings: ${WARNINGS}"
    fi
    return "${EXIT_CODE}"
}

main "$@"
