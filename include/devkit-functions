#!/bin/sh

################################################################################
#
#   Lynis SDK — devkit-functions v1.1.0
#
# Cambios:
#   - SDKCheckTool():  función reutilizable para verificar dependencias
#   - SDKBuildPackageDEB(): verifica exit code de dpkg-buildpackage
#   - SDKBuildPackageRPM(): corrige ruta ~/lynis-build (no ./tmp/),
#     verifica exit code de rpmbuild
#   - SDKPrintOK/SDKPrintFailed: con colores si TTY disponible
#   - SDKLogText(): wrapper de logging compatible con Lynis LogText
#
################################################################################

    ############################################################################
    # SDKCheckTool TOOL [INSTALL_HINT]
    # Verifica que TOOL está en PATH. Si no, llama SDKExitFatal con mensaje
    # opcional de instalación.
    ############################################################################
    SDKCheckTool() {
        _sdk_tool="$1"
        _sdk_hint="${2:-}"
        if ! command -v "${_sdk_tool}" > /dev/null 2>&1; then
            if [ -n "${_sdk_hint}" ]; then
                SDKExitFatal "'${_sdk_tool}' no encontrado. Para instalar: ${_sdk_hint}"
            else
                SDKExitFatal "'${_sdk_tool}' no encontrado en PATH"
            fi
        fi
        SDKLogText "SDKCheckTool: '${_sdk_tool}' encontrado"
    }

    ############################################################################
    # SDKBuildPackageDEB()
    # Construye un paquete .deb verificando dependencias y exit codes.
    ############################################################################
    SDKBuildPackageDEB() {
        SDKLogText "SDKBuildPackageDEB: iniciando construcción de paquete DEB"

        if [ -x /usr/bin/dpkg ]; then
            dpkg -l dpkg-dev 2>/dev/null | grep "^ii" | grep -q "dpkg-dev" \
                || SDKExitFatal "Paquete 'dpkg-dev' no instalado. Instalar con: apt-get install dpkg-dev"
            dpkg -l debhelper 2>/dev/null | grep "^ii" | grep -q "debhelper" \
                || SDKExitFatal "Paquete 'debhelper' no instalado. Instalar con: apt-get install debhelper"
        else
            SDKLogText "SDKBuildPackageDEB: dpkg no disponible, omitiendo verificación de dependencias"
            printf '[WARN]  dpkg no disponible: no se verificaron dependencias DEB\n'
        fi

        printf 'Building DEB package...\n'
        SDKShowLine

        if dpkg-buildpackage -b -us -uc; then
            SDKLogText "SDKBuildPackageDEB: construcción DEB completada correctamente"
            SDKShowLine
            SDKPrintOK
        else
            _deb_rc=$?
            SDKLogText "SDKBuildPackageDEB: dpkg-buildpackage falló con código ${_deb_rc}"
            SDKShowLine
            SDKPrintFailed
            SDKExitFatal "dpkg-buildpackage falló (código de salida: ${_deb_rc})"
        fi
    }

    ############################################################################
    # SDKBuildPackageRPM()
    # Construye un paquete .rpm verificando dependencias y exit codes.
    # CORRECCIÓN: usa ~/lynis-build (no ./tmp/lynis-build que no existe).
    ############################################################################
    SDKBuildPackageRPM() {
        SDKLogText "SDKBuildPackageRPM: iniciando construcción de paquete RPM"

        SDKCheckTool "rpmbuild" "yum install rpm-build  # RHEL/CentOS\n  dnf install rpm-build  # Fedora"

        if [ -x /usr/bin/dpkg ]; then
            dpkg -l rpm 2>/dev/null | grep "^ii" | grep -q "rpm" \
                || SDKExitFatal "Paquete 'rpm' no instalado. Instalar con: apt-get install rpm"
        fi

        # Verificar que el directorio fuente de Lynis existe antes de empaquetar
        if [ ! -d "${LYNIS_PATH}" ]; then
            SDKExitFatal "Directorio de Lynis no encontrado: ${LYNIS_PATH}"
        fi

        # Crear estructura rpmbuild en HOME (ruta correcta, no ./tmp/)
        _rpm_base="${HOME}/lynis-build/rpmbuild"
        for _dir in BUILD BUILDROOT RPMS SOURCES SRPMS; do
            if [ ! -d "${_rpm_base}/${_dir}" ]; then
                mkdir -p "${_rpm_base}/${_dir}" \
                    || SDKExitFatal "No se pudo crear: ${_rpm_base}/${_dir}"
                SDKLogText "SDKBuildPackageRPM: creado directorio ${_rpm_base}/${_dir}"
            fi
        done

        printf 'Building RPM package...\n'
        SDKShowLine

        # Crear tarball fuente
        _tarball="${_rpm_base}/SOURCES/lynis-${LYNIS_VERSION}.tar.gz"
        SDKLogText "SDKBuildPackageRPM: creando tarball ${_tarball}"
        tar --create -z -f "${_tarball}" -C "$(dirname "${LYNIS_PATH}")" "$(basename "${LYNIS_PATH}")" \
            || SDKExitFatal "No se pudo crear el tarball: ${_tarball}"

        SDKShowLine
        ls -lh "${_tarball}" || true
        SDKShowLine

        # Construir RPM y verificar exit code
        if rpmbuild -ba ./package-building/lynis.spec \
               --define "_topdir ${_rpm_base}"; then
            SDKLogText "SDKBuildPackageRPM: construcción RPM completada correctamente"
            SDKShowLine
            SDKPrintOK
        else
            _rpm_rc=$?
            SDKLogText "SDKBuildPackageRPM: rpmbuild falló con código ${_rpm_rc}"
            SDKShowLine
            SDKPrintFailed
            SDKExitFatal "rpmbuild falló (código de salida: ${_rpm_rc})"
        fi
    }

    ############################################################################
    # SDKExitFatal MSG
    # Termina el programa con error fatal.
    ############################################################################
    SDKExitFatal() {
        printf '%s[FATAL]%s %s\n' "${RED:-}" "${NORMAL:-}" "$1" >&2
        exit 1
    }

    ############################################################################
    # SDKLogText MSG
    # Wrapper de logging: usa LogText() de Lynis si está disponible,
    # de lo contrario escribe directamente al LOGFILE del devkit.
    ############################################################################
    SDKLogText() {
        if command -v LogText > /dev/null 2>&1; then
            LogText "[SDK] $1"
        else
            printf '[%s] [SDK  ] %s\n' \
                "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "${LOGFILE:-/dev/null}"
        fi
    }

    ############################################################################
    # SDKShowLine()
    # Imprime una línea separadora.
    ############################################################################
    SDKShowLine() {
        printf '===============================================================\n'
    }

    ############################################################################
    # SDKPrintOK()
    # Imprime resultado OK con color verde si TTY disponible.
    ############################################################################
    SDKPrintOK() {
        printf ' %s[ OK ]%s\n' "${GREEN:-}" "${NORMAL:-}"
    }

    ############################################################################
    # SDKPrintFailed()
    # Imprime resultado FAILED con color rojo si TTY disponible.
    ############################################################################
    SDKPrintFailed() {
        printf ' %s[FAILED]%s\n' "${RED:-}" "${NORMAL:-}"
    }

# EOF
